#pragma kernel ExecuteFallingFluidIntegration

#include "Include/SphCommon.hlsl"

struct CanvasPaintHit
{
    float3 WorldPosition;
    float PaintWeight;
    uint PackedColorRGBA;
    float WetnessDeposit;
};

StructuredBuffer<float4> _FallingReadBlock0;
StructuredBuffer<float4> _FallingReadBlock1;
StructuredBuffer<uint> _FallingReadPackedColors;
StructuredBuffer<float> _FallingReadWetness;

AppendStructuredBuffer<float4> _FallingAppendBlock0;
AppendStructuredBuffer<float4> _FallingAppendBlock1;
AppendStructuredBuffer<uint> _FallingAppendPackedColors;
AppendStructuredBuffer<float> _FallingAppendWetness;
AppendStructuredBuffer<CanvasPaintHit> _CanvasHitAppend;

uint _FallingCount;
float _DeltaTime;
float3 _WorldGravity;
float _WorldDrag;
float _CanvasPlaneY;
uint _CanvasCullingEnabled;
uint _CanvasPaintAbsorbEnabled;
float _CanvasAbsorbRate;
float _CanvasAbsorbPaintWeightScale;
float _FloorRestitution;
float _FloorFriction;

void AppendFallingParticle(
    float3 pos, float3 vel, float density, float pressure, uint packedColor, float wetness)
{
    _FallingAppendBlock0.Append(float4(pos, density));
    _FallingAppendBlock1.Append(float4(vel, pressure));
    _FallingAppendPackedColors.Append(packedColor);
    _FallingAppendWetness.Append(wetness);
}

void AppendCanvasHit(float3 worldPos, float weight, uint packedColor, float wetnessDeposit)
{
    CanvasPaintHit hit;
    hit.WorldPosition = worldPos;
    hit.PaintWeight = weight;
    hit.PackedColorRGBA = packedColor;
    hit.WetnessDeposit = wetnessDeposit;
    _CanvasHitAppend.Append(hit);
}

[numthreads(64, 1, 1)]
void ExecuteFallingFluidIntegration(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _FallingCount)
    {
        return;
    }

    uint i = id.x;
    float4 b0 = _FallingReadBlock0[i];
    float4 b1 = _FallingReadBlock1[i];
    float3 pos = b0.xyz;
    float3 vel = b1.xyz;
    float density = b0.w;
    float pressure = b1.w;
    uint packedColor = _FallingReadPackedColors[i];
    float wetness = _FallingReadWetness[i];

    vel += _WorldGravity * _DeltaTime;
    vel *= max(0.0, 1.0 - _WorldDrag * _DeltaTime);
    pos += vel * _DeltaTime;

    if (pos.y <= _CanvasPlaneY)
    {
        if (_CanvasCullingEnabled != 0)
        {
            if (_CanvasPaintAbsorbEnabled != 0)
            {
                pos.y = _CanvasPlaneY;
                vel = float3(0, 0, 0);

                if (wetness <= 0.0)
                {
                    wetness = 1.0;
                }

                float absorbed = min(wetness, _CanvasAbsorbRate * _DeltaTime);
                wetness -= absorbed;

                if (absorbed > 0.0)
                {
                    AppendCanvasHit(
                        pos,
                        absorbed * _CanvasAbsorbPaintWeightScale,
                        packedColor,
                        absorbed);
                }

                if (wetness > 0.0)
                {
                    AppendFallingParticle(pos, vel, density, pressure, packedColor, wetness);
                }

                return;
            }

            AppendCanvasHit(
                pos,
                length(vel),
                packedColor,
                1.0);
            return;
        }

        pos.y = _CanvasPlaneY;
        vel.y = -vel.y * _FloorRestitution;
        vel.x *= _FloorFriction;
        vel.z *= _FloorFriction;
    }

    AppendFallingParticle(pos, vel, density, pressure, packedColor, wetness);
}
