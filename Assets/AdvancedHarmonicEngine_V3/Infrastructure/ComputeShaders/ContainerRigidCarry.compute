#pragma kernel ContainerRigidCarryKernel

uint _ActiveParticleCount;
uint _MaxParticleCount;
float4x4 _ContainerRotationDelta;
float3 _ContainerAngularVelocityWorld;
float3 _ContainerFloorPivot;

RWStructuredBuffer<float4> _Block0;
RWStructuredBuffer<float4> _Block1;

[numthreads(64, 1, 1)]
void ContainerRigidCarryKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount || i >= _MaxParticleCount)
    {
        return;
    }

    float4 block0 = _Block0[i];
    float4 block1 = _Block1[i];
    float3 pos = block0.xyz;
    float3 vel = block1.xyz;

    float3 newPos = mul(_ContainerRotationDelta, float4(pos, 1.0)).xyz;
    float3 arm = pos - _ContainerFloorPivot;
    float3 newVel = vel + cross(_ContainerAngularVelocityWorld, arm);

    _Block0[i] = float4(newPos, block0.w);
    _Block1[i] = float4(newVel, block1.w);
}
