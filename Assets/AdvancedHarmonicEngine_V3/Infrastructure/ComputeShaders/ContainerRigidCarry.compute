#pragma kernel ContainerRigidCarryKernel

uint _ActiveParticleCount;
uint _MaxParticleCount;
float4x4 _ContainerRotationDelta;
float4x4 _ContainerLocalToWorld;
float4x4 _ContainerWorldToLocal;
float3 _ContainerAngularVelocityWorld;
float3 _ContainerLinearVelocityWorld;
float3 _ContainerFloorPivot;
float _ContainerHeight;
float _ContainerRadius;
int _ContainerSpillEnabled;
int _ContainerUsesOrientation;
float3 _ContainerCenter;
float _ContainerFloorY;
float _ContainerRimY;
float _ContainerRestitution;
float _ContainerFriction;

#include "Include/OpenTopCylinderBoundary.hlsl"
#include "Include/OtcParticleField.hlsl"

RWStructuredBuffer<float4> _Block0;
RWStructuredBuffer<float4> _Block1;
RWStructuredBuffer<float3> _PrevCarryContribution;
// Persistent "carry-earned last frame" flag (0/1). Despite the historical name, this now
// records velocity-agreement entrainment state, not raw geometric containment.
RWStructuredBuffer<uint> _PrevInsideForCarry;

// Max speed (world units/sec) a particle's velocity may differ from the container's rigid
// point velocity and still be admitted as entrained fluid. Above this, a particle inside the
// geometric volume is treated as swept debris (stationary ground particle vs moving bucket)
// and left on ordinary PBF/exterior physics until its velocity naturally converges.
// TUNABLE: 0.25 chosen to sit well above settled-fluid residuals (<~0.1) yet far below sweep
// speeds (>>1). Calibrate against RigidCarryContinuity legitimate-entrainment test frame count.
static const float EARN_VELOCITY_THRESHOLD = 0.25;

[numthreads(64, 1, 1)]
void ContainerRigidCarryKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount || i >= _MaxParticleCount)
    {
        return;
    }

    float4 block0 = _Block0[i];
    float4 block1 = _Block1[i];
    float3 pos = block0.xyz;
    float3 vel = block1.xyz;

    bool currentlyInside = OtcFieldInsideRigidCarry(i);
    bool wasEarnedLastFrame = _PrevInsideForCarry[i] != 0u;

    float3 arm = pos - _ContainerFloorPivot;
    float3 rotContribution = cross(_ContainerAngularVelocityWorld, arm);

    // Velocity this point WOULD have if rigidly carried by the container.
    float3 expectedLocalVel = _ContainerLinearVelocityWorld + rotContribution;
    float relativeSpeed = length(vel - expectedLocalVel);

    // Carry entrainment is earned by velocity agreement and persists while inside:
    //   (a) already earned last frame and still inside — real fluid stays fluid, or
    //   (b) inside AND already moving with the container (relativeSpeed below threshold).
    // A particle inside but moving very differently (swept ground debris) is NOT promoted;
    // it is re-evaluated every frame until friction/clamp contact converges its velocity.
    bool earnedThisFrame = currentlyInside && (wasEarnedLastFrame || relativeSpeed < EARN_VELOCITY_THRESHOLD);

    if (earnedThisFrame)
    {
        float3 newPos = mul(_ContainerRotationDelta, float4(pos, 1.0)).xyz;
        float3 newVel = (vel - _PrevCarryContribution[i]) + rotContribution;
        _PrevCarryContribution[i] = rotContribution;

        OtcClampToContainer(newPos, newVel);

        _Block0[i] = float4(newPos, block0.w);
        _Block1[i] = float4(newVel, block1.w);
    }
    else
    {
        // Not entrained this frame (outside, or inside-but-unconverged debris) — leave pos/vel
        // to ordinary PBF/exterior physics and drop any stale carry contribution bookkeeping.
        _PrevCarryContribution[i] = float3(0.0, 0.0, 0.0);
    }

    _PrevInsideForCarry[i] = earnedThisFrame ? 1u : 0u;
}
