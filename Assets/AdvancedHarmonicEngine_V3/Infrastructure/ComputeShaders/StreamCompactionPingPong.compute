#pragma kernel ExecuteSphDensityPass

#include "Include/SphCommon.hlsl"
#include "Include/SphSoaAccess.hlsl"

StructuredBuffer<GridKeyPair> _SortedGridKeyValueBuffer;
StructuredBuffer<HashCellGridRange> _CellStartEndBuffer;
RWStructuredBuffer<float> _DensityCacheDensities;
RWStructuredBuffer<float> _DensityCachePressures;

uint _ActiveParticleCount;
uint _GridResolution;
float _CellSize;
float _SmoothingRadius;
float _ParticleMass;
float _StiffnessB;
float _RestDensity;
uint _MaxParticleCount;

#include "Include/SphNeighborQuery.hlsl"

[numthreads(64, 1, 1)]
void ExecuteSphDensityPass(uint3 id : SV_DispatchThreadID)
{
    uint particleIndex = id.x;
    if (particleIndex >= _ActiveParticleCount || particleIndex >= _MaxParticleCount)
    {
        return;
    }

    float density;
    float3 pressureGrad;
    float3 viscosityForce;
    float3 colorLaplacian;
    ForEachNeighbor(particleIndex, false, density, pressureGrad, viscosityForce, colorLaplacian);

    density = max(density, _RestDensity * 0.01);
    float ratio = density / _RestDensity;
    float p = _StiffnessB * (pow(max(ratio, 1.0), 3.0) - 1.0);
    float pressure = max(p, 0.0);

    _DensityCacheDensities[particleIndex] = density;
    _DensityCachePressures[particleIndex] = pressure;
}
