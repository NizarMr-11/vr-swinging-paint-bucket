// PBF core (spec section 6, plan Phase 4). Written fresh for V4 - no V3 solver code.
// Per frame: Predict -> grid build (external) -> 2x (Density -> Lambda -> SolveDelta
// -> ApplyDelta) -> Finalize -> compaction sort (external) -> Gather.
//
// Determinism: SolveDelta writes into _Deltas (Jacobi style, no in-place races) and
// compaction goes through the radix sort (order preserving), so identical inputs
// produce identical outputs - required by the golden-frame and canvas-determinism tests.

#pragma kernel PredictKernel
#pragma kernel DensityKernel
#pragma kernel LambdaKernel
#pragma kernel SolveDeltaKernel
#pragma kernel ApplyDeltaKernel
#pragma kernel FinalizeKernel
#pragma kernel FinalizeTermsProbeKernel
#pragma kernel BoundaryPressureNeighborKernel
#pragma kernel GatherKernel

#include "Include/V4Common.hlsl"
#include "Include/V4BucketZones.hlsl"
#include "Include/V4Profiles.hlsl"
#include "Include/V4NeighborQuery.hlsl"

#define COUNTER_WRITE_COUNT 0
#define COUNTER_ESCAPED_TOTAL 1
#define COUNTER_SETTLED_TOTAL 2
#define COUNTER_SPLAT_EVENTS 4

struct V4SplatEvent
{
    float2 uv;            // canvas-local meters from the min corner
    float radius;
    float contribution;
    uint color;
    uint pad0;
    uint pad1;
    uint pad2;
};

// Read set (canonical state)
StructuredBuffer<float4> _Block0;
StructuredBuffer<float4> _Block1;
StructuredBuffer<uint> _PackedColorsRead;
StructuredBuffer<uint> _Flags;

// In-place color target (bound to the same buffer as _PackedColorsRead; each thread
// only ever writes its own index, so this is race-free and deterministic).
RWStructuredBuffer<uint> _PackedColors;

// Scratch
RWStructuredBuffer<float4> _Predicted;     // predicted position.xyz, radius
RWStructuredBuffer<float> _Densities;
RWStructuredBuffer<float> _Lambdas;
RWStructuredBuffer<float4> _Deltas;
RWStructuredBuffer<float4> _BlendedColors; // rgb = weighted color sum, w = weight sum

// Write set (compaction staging)
RWStructuredBuffer<float4> _WriteBlock0;
RWStructuredBuffer<float4> _WriteBlock1;
RWStructuredBuffer<uint> _WritePackedColors;
RWStructuredBuffer<uint> _WriteFlags;

// Grid (read-only in density/lambda/solve/finalize)
StructuredBuffer<HashCellGridRange> _CellStartEndBuffer;
StructuredBuffer<uint2> _GridKeyValueBuffer;

// Compaction staging: (key, index) pairs written by Finalize, sorted externally by
// the radix sort (removed particles get the max key so survivors keep their order).
RWStructuredBuffer<uint2> _CompactionPairs;

// Read-only alias of _Predicted for FinalizeKernel (bound to the same buffer in a
// different dispatch; keeps Finalize within the UAV budget).
StructuredBuffer<float4> _PredictedRead;

// Gather bindings (GatherKernel only). Sources are the write-staging buffers and the
// sorted pairs, re-declared under read-only names so the kernel stays at 4 UAVs;
// targets are the canonical read-set buffers.
StructuredBuffer<uint2> _SortedPairs;
StructuredBuffer<float4> _StageBlock0;
StructuredBuffer<float4> _StageBlock1;
StructuredBuffer<uint> _StageColors;
StructuredBuffer<uint> _StageFlags;
RWStructuredBuffer<float4> _GatherBlock0;
RWStructuredBuffer<float4> _GatherBlock1;
RWStructuredBuffer<uint> _GatherColors;
RWStructuredBuffer<uint> _GatherFlags;

RWStructuredBuffer<uint> _Counters;
RWStructuredBuffer<V4SplatEvent> _SplatEvents;
StructuredBuffer<V4GpuProfile> _Profiles;
StructuredBuffer<V4Hole> _Holes;

float4x4 _BucketWorldToLocal;
float4x4 _BucketLocalToWorld;
float3 _BucketLinearVelocity;
float3 _BucketAngularVelocity;
float3 _BucketWorldOrigin;
float _BucketInnerRadius;
float _BucketHeight;
float _BucketWallThickness;

float _DeltaTime;
float _SmoothingRadius;
float _CellSize;
uint _GridResolution;
uint _ActiveParticleCount;
float _PbfEpsilon;             // CFM relaxation epsilon

float _CanvasPlaneY;
float2 _CanvasMinCorner;       // world XZ of the canvas min corner
float2 _CanvasSize;            // world meters (width, depth)
float _SettleDistance;         // how close above the plane counts as "on canvas"
uint _MaxSplatEvents;
uint _DebugDisableBoundaryGhosts; // test instrumentation: skip mirror ghosts when non-zero
float _BoundaryGhostWeight;        // scales mirror density + gradient consistently
float _DebugScorrRatioMax;         // test instrumentation: clamp wRatio before pow (0 = off)
uint _DebugScorrApplyMode;         // test instrumentation: 1=divide scorr by iter count
uint _DebugScorrSaturatePow;       // test instrumentation: saturate the pow() result
float _DebugMaxCorrectionScale;    // test instrumentation: 0=default 0.2h, >0=scale*h, <0=uncapped
uint _PbfIterationIndex;
uint _PbfIterationCount;

// Test instrumentation: FinalizeTermsProbeKernel writes six float4 rows per tracked slot.
static const uint kV4DebugFinalizeProbeSlots = 8u;
static const uint kV4DebugFinalizeProbeRowsPerSlot = 6u;
uint _DebugTrackCount;
uint _DebugTrackIndices[kV4DebugFinalizeProbeSlots];
RWStructuredBuffer<float4> _DebugFinalizeProbe;
RWStructuredBuffer<uint> _DebugBoundaryPressureNeighbors;

// ---------------------------------------------------------------------------

float3 V4ToLocal(float3 worldPos)
{
    return mul(_BucketWorldToLocal, float4(worldPos, 1.0)).xyz;
}

float3 V4ToWorld(float3 localPos)
{
    return mul(_BucketLocalToWorld, float4(localPos, 1.0)).xyz;
}

// Mirror-particle boundary density/gradient for bucket floor and inner wall.
// Mirrors are computed in bucket-local space; kernel distances use world space.
void V4AddBoundaryGhostDensity(float3 worldPos, float3 localPos, inout float density, float h)
{
    if (localPos.y < h)
    {
        float3 mirrorLocal = float3(localPos.x, -localPos.y, localPos.z);
        float3 mirrorWorld = V4ToWorld(mirrorLocal);
        float rMirror = distance(worldPos, mirrorWorld);
        density += _BoundaryGhostWeight * V4Poly6(rMirror, h);
    }

    float radXZ = length(localPos.xz);
    if (radXZ > _BucketInnerRadius - h)
    {
        float2 dirXZ = localPos.xz / max(radXZ, 1e-5);
        float mirrorRad = 2.0 * _BucketInnerRadius - radXZ;
        float3 mirrorLocal = float3(dirXZ.x * mirrorRad, localPos.y, dirXZ.y * mirrorRad);
        float3 mirrorWorld = V4ToWorld(mirrorLocal);
        float rMirror = distance(worldPos, mirrorWorld);
        density += _BoundaryGhostWeight * V4Poly6(rMirror, h);
    }
}

void V4AddBoundaryGhostGradSum(float3 worldPos, float3 localPos, inout float gradSum, float h, float restDensity)
{
    if (localPos.y < h)
    {
        float3 mirrorLocal = float3(localPos.x, -localPos.y, localPos.z);
        float3 mirrorWorld = V4ToWorld(mirrorLocal);
        float rMirror = distance(worldPos, mirrorWorld);
        float3 gradMirror = V4SpikyGradient(worldPos - mirrorWorld, rMirror, h) / restDensity;
        gradSum += _BoundaryGhostWeight * dot(gradMirror, gradMirror);
    }

    float radXZ = length(localPos.xz);
    if (radXZ > _BucketInnerRadius - h)
    {
        float2 dirXZ = localPos.xz / max(radXZ, 1e-5);
        float mirrorRad = 2.0 * _BucketInnerRadius - radXZ;
        float3 mirrorLocal = float3(dirXZ.x * mirrorRad, localPos.y, dirXZ.y * mirrorRad);
        float3 mirrorWorld = V4ToWorld(mirrorLocal);
        float rMirror = distance(worldPos, mirrorWorld);
        float3 gradMirror = V4SpikyGradient(worldPos - mirrorWorld, rMirror, h) / restDensity;
        gradSum += _BoundaryGhostWeight * dot(gradMirror, gradMirror);
    }
}

// Containment decision for a mid-frame position (see V4BucketResolveCollision's
// caller contract). Three ways in:
//   1. frame-start Inside flag - authoritative classification;
//   2. current-position footprint - geometric fallback;
//   3. frame-start reference footprint with a face tolerance: a particle pinned at
//      exactly r = R flickers Outside by one float ulp in classification, and a
//      spawn-collapse jet can hop it past the wall mid-plane in a single step -
//      without the reference check nearest-face resolution ejects it through the
//      wall (the measured Lab2 floor-corner leak).
bool V4ComputeContainInside(uint flags, float3 localPos, float3 refLocalPos)
{
    if (V4IsInside(flags))
    {
        return true;
    }

    if (V4BucketShouldContainInside(localPos, _BucketInnerRadius, _BucketHeight, _BucketWallThickness))
    {
        return true;
    }

    const float faceEps = 1e-4;
    return V4BucketShouldContainInside(refLocalPos, _BucketInnerRadius + faceEps, _BucketHeight, _BucketWallThickness);
}

// Position-only bucket clamp used inside the solver loop. Uses the same moving contact
// frame as FinalizeKernel: approach velocity from (worldPos - refWorldPos) and the
// per-point bucket contact velocity. Reflected velocity delta is fed back into the
// clamped world position so wall-pinned PBF corrections see a co-moving boundary.
float3 V4ClampPositionToBucket(float3 worldPos, uint flags, float3 refWorldPos)
{
    if (V4HasEscaped(flags))
    {
        return worldPos;
    }

    float3 localPos = V4ToLocal(worldPos);
    bool containInside = V4ComputeContainInside(flags, localPos, V4ToLocal(refWorldPos));
    float3 approachVelWorld = (worldPos - refWorldPos) / max(_DeltaTime, 1e-6);
    float3 localVel = mul((float3x3)_BucketWorldToLocal, approachVelWorld);
    float3 localVelBefore = localVel;
    float3 contactVelWorld = _BucketLinearVelocity + cross(_BucketAngularVelocity, worldPos - _BucketWorldOrigin);
    float3 contactVelLocal = mul((float3x3)_BucketWorldToLocal, contactVelWorld);
    V4BucketResolveCollision(localPos, localVel, _BucketInnerRadius, _BucketHeight, _BucketWallThickness, 0.0, 0.0,
        containInside, contactVelLocal);
    float3 velDeltaWorld = mul((float3x3)_BucketLocalToWorld, localVel - localVelBefore) * _DeltaTime;
    return V4ToWorld(localPos) + velDeltaWorld;
}

[numthreads(64, 1, 1)]
void PredictKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount)
    {
        return;
    }

    float4 p = _Block0[i];
    float3 vel = _Block1[i].xyz;
    float3 predicted = p.xyz + vel * _DeltaTime;

    predicted = V4ClampPositionToBucket(predicted, _Flags[i], p.xyz);
    predicted.y = max(predicted.y, _CanvasPlaneY + p.w);

    _Predicted[i] = float4(predicted, p.w);
}

[numthreads(64, 1, 1)]
void DensityKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount)
    {
        return;
    }

    float3 pi = _Predicted[i].xyz;
    float h = _SmoothingRadius;
    uint flags = _Flags[i];
    float3 localPos = V4ToLocal(pi);
    bool addBoundaryGhosts = (_DebugDisableBoundaryGhosts == 0u)
        && !V4HasEscaped(flags)
        && V4BucketShouldContainInside(localPos, _BucketInnerRadius, _BucketHeight, _BucketWallThickness);

    float density = V4Poly6(0.0, h); // self contribution
    float3 colorSum = float3(0, 0, 0);
    float weightSum = 0.0;

    V4_FOREACH_NEIGHBOR_BEGIN(pi, j)
        if (j == i || j >= _ActiveParticleCount)
        {
            continue;
        }

        float3 diff = pi - _Predicted[j].xyz;
        float r = length(diff);
        if (r > h)
        {
            continue;
        }

        float w = V4Poly6(r, h);
        density += w;

        // Kernel-weighted neighbor color accumulation (spec section 6.4):
        // reuses the same neighbor iteration as density, so blending is free.
        colorSum += V4UnpackColor(_PackedColorsRead[j]) * w;
        weightSum += w;
    V4_FOREACH_NEIGHBOR_END

    if (addBoundaryGhosts)
    {
        V4AddBoundaryGhostDensity(pi, localPos, density, h);
    }

    _Densities[i] = density;
    _BlendedColors[i] = float4(colorSum, weightSum);
}

[numthreads(64, 1, 1)]
void LambdaKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount)
    {
        return;
    }

    float3 pi = _Predicted[i].xyz;
    float h = _SmoothingRadius;
    uint flags = _Flags[i];
    float3 localPos = V4ToLocal(pi);
    bool addBoundaryGhosts = (_DebugDisableBoundaryGhosts == 0u)
        && !V4HasEscaped(flags)
        && V4BucketShouldContainInside(localPos, _BucketInnerRadius, _BucketHeight, _BucketWallThickness);
    float restDensity = max(_Profiles[V4GetProfile(flags)].restDensity, 1e-4);

    float constraint = _Densities[i] / restDensity - 1.0;
    if (constraint <= 0.0)
    {
        _Lambdas[i] = 0.0;
        return;
    }

    float3 gradSelf = float3(0, 0, 0);
    float gradSum = 0.0;

    V4_FOREACH_NEIGHBOR_BEGIN(pi, j)
        if (j == i || j >= _ActiveParticleCount)
        {
            continue;
        }

        float3 diff = pi - _Predicted[j].xyz;
        float r = length(diff);
        if (r > h)
        {
            continue;
        }

        float3 grad = V4SpikyGradient(diff, r, h) / restDensity;
        gradSelf += grad;
        gradSum += dot(grad, grad);
    V4_FOREACH_NEIGHBOR_END

    if (addBoundaryGhosts)
    {
        V4AddBoundaryGhostGradSum(pi, localPos, gradSum, h, restDensity);
    }

    gradSum += dot(gradSelf, gradSelf);
    _Lambdas[i] = -constraint / (gradSum + _PbfEpsilon);
}

[numthreads(64, 1, 1)]
void SolveDeltaKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount)
    {
        return;
    }

    float3 pi = _Predicted[i].xyz;
    float h = _SmoothingRadius;
    uint flags = _Flags[i];
    V4GpuProfile profile = _Profiles[V4GetProfile(flags)];
    float restDensity = max(profile.restDensity, 1e-4);
    float lambdaI = _Lambdas[i];

    float3 delta = float3(0, 0, 0);
    float wCorrDenom = V4Poly6(profile.pbfDeltaQScale * h, h);
    V4_FOREACH_NEIGHBOR_BEGIN(pi, j)
        if (j == i || j >= _ActiveParticleCount)
        {
            continue;
        }

        float3 diff = pi - _Predicted[j].xyz;
        float r = length(diff);
        if (r > h)
        {
            continue;
        }

        float wCorrNum = V4Poly6(r, h);
        float scorr = 0.0;
        // Macklin & Mueller s_corr: apply only on the final PBF iteration to avoid
        // compounding repulsive corrections across Jacobi passes (rim leak at high iter).
        if ((_PbfIterationIndex + 1u) >= _PbfIterationCount)
        {
            float wRatio = max(wCorrNum / max(wCorrDenom, 1e-6), 0.0);
            if (_DebugScorrRatioMax > 0.0)
            {
                wRatio = min(wRatio, _DebugScorrRatioMax);
            }

            float scorrPow = pow(abs(wRatio), profile.pbfNCorr);
            if (_DebugScorrSaturatePow != 0u)
            {
                scorrPow = saturate(scorrPow);
            }

            scorr = -profile.pbfKCorr * scorrPow;
            if (_DebugScorrApplyMode == 1u)
            {
                scorr /= max((float)_PbfIterationCount, 1.0);
            }
        }

        delta += (lambdaI + _Lambdas[j] + scorr) * V4SpikyGradient(diff, r, h);
    V4_FOREACH_NEIGHBOR_END

    _Deltas[i] = float4(delta / restDensity, 0.0);
}

[numthreads(64, 1, 1)]
void ApplyDeltaKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount)
    {
        return;
    }

    float4 p = _Predicted[i];

    // Clamp the per-iteration pressure correction. A deeply compressed spawn or
    // impact column otherwise produces meter-scale corrections in one frame, which
    // Finalize converts into 10+ m/s detonation velocities that blast particles
    // over the rim. Excess compression now relaxes over several frames instead.
    float3 delta = _Deltas[i].xyz;
    float maxCorrection = 0.2 * _SmoothingRadius;
    if (_DebugMaxCorrectionScale < 0.0)
    {
        maxCorrection = 1e10;
    }
    else if (_DebugMaxCorrectionScale > 0.0)
    {
        maxCorrection = _DebugMaxCorrectionScale * _SmoothingRadius;
    }

    float deltaLen = length(delta);
    if (deltaLen > maxCorrection)
    {
        delta *= maxCorrection / deltaLen;
    }

    float3 predicted = p.xyz + delta;
    predicted = V4ClampPositionToBucket(predicted, _Flags[i], _Block0[i].xyz);
    predicted.y = max(predicted.y, _CanvasPlaneY + p.w);
    _Predicted[i] = float4(predicted, p.w);

    // Color blend, once per PBF iteration (spec section 6.4):
    // color = lerp(color, kernelWeightedNeighborAverage, k).
    // Reads and writes only this thread's own slot of the RW color buffer
    // (a buffer cannot be bound as both SRV and UAV in one dispatch).
    float4 blend = _BlendedColors[i];
    if (blend.w > 1e-6)
    {
        float k = _Profiles[V4GetProfile(_Flags[i])].colorDiffusionRate;
        float3 own = V4UnpackColor(_PackedColors[i]);
        float3 avg = blend.xyz / blend.w;
        _PackedColors[i] = V4PackColor(lerp(own, avg, saturate(k)));
    }
}

[numthreads(64, 1, 1)]
void FinalizeKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount)
    {
        return;
    }

    uint flags = _Flags[i];
    V4GpuProfile profile = _Profiles[V4GetProfile(flags)];

    float4 oldP = _Block0[i];
    float radius = oldP.w;
    float3 predicted = _PredictedRead[i].xyz;
    float3 vel = _DeltaTime > 1e-6 ? (predicted - oldP.xyz) / _DeltaTime : float3(0, 0, 0);

    // XSPH viscosity + cohesion over the predicted-position grid.
    float h = _SmoothingRadius;
    float3 xsph = float3(0, 0, 0);
    float3 cohesion = float3(0, 0, 0);
    V4_FOREACH_NEIGHBOR_BEGIN(predicted, j)
        if (j == i || j >= _ActiveParticleCount)
        {
            continue;
        }

        float3 diff = predicted - _PredictedRead[j].xyz;
        float r = length(diff);
        if (r > h)
        {
            continue;
        }

        float w = V4Poly6(r, h);
        float3 vj = _DeltaTime > 1e-6 ? (_PredictedRead[j].xyz - _Block0[j].xyz) / _DeltaTime : float3(0, 0, 0);
        xsph += (vj - vel) * w;
        if (r > 1e-6)
        {
            cohesion -= (diff / r) * w;
        }
    V4_FOREACH_NEIGHBOR_END

    float selfW = max(V4Poly6(0.0, h), 1e-6);
    vel += profile.viscosity * (xsph / selfW);
    vel += profile.cohesion * (cohesion / selfW) * _DeltaTime;

    float3 pos = predicted;

    // Full bucket collision (position + velocity). Escaped particles skip it forever.
    // Containment follows the frame-start flag/footprint (V4ComputeContainInside):
    // a particle that punched past the wall mid-plane this frame must be pulled back
    // to the inner face, never handed to nearest-face resolution.
    if (!V4HasEscaped(flags))
    {
        float3 localPos = V4ToLocal(pos);
        float3 localVel = mul((float3x3)_BucketWorldToLocal, vel);
        float3 contactVelWorld = _BucketLinearVelocity + cross(_BucketAngularVelocity, pos - _BucketWorldOrigin);
        float3 contactVelLocal = mul((float3x3)_BucketWorldToLocal, contactVelWorld);
        bool containInside = V4ComputeContainInside(flags, localPos, V4ToLocal(oldP.xyz));
        V4BucketResolveCollision(localPos, localVel, _BucketInnerRadius, _BucketHeight, _BucketWallThickness,
            profile.surfaceRestitution, profile.surfaceFriction, containInside, contactVelLocal);
        pos = V4ToWorld(localPos);
        vel = mul((float3x3)_BucketLocalToWorld, localVel);
    }

    bool removed = false;
    float2 uv = float2(pos.x, pos.z) - _CanvasMinCorner;
    bool onCanvasRect = uv.x >= 0.0 && uv.y >= 0.0 && uv.x <= _CanvasSize.x && uv.y <= _CanvasSize.y;
    bool touchingPlane = (pos.y - radius) <= (_CanvasPlaneY + 1e-5);

    // Impact speed comes from the incoming velocity, not the position delta: the
    // predict-stage plane clamp truncates the delta right at contact, which would
    // hide most of the real approach speed.
    float impactSpeed = max(0.0, -_Block1[i].y);

    // Impact splash (spec section 7 extension): a particle slamming into the canvas is
    // absorbed on contact - it explodes into a splat whose footprint and paint depth
    // grow with impact speed, instead of bouncing and waiting for the slow-settle path.
    if (!V4IsInside(flags) && touchingPlane && onCanvasRect && impactSpeed > profile.impactAbsorbSpeed)
    {
        uint slot;
        InterlockedAdd(_Counters[COUNTER_SPLAT_EVENTS], 1u, slot);
        if (slot < _MaxSplatEvents)
        {
            V4SplatEvent evt;
            evt.uv = uv;
            evt.radius = radius * (1.0 + impactSpeed * profile.impactSplashScale);
            evt.contribution = 1.0 + impactSpeed * profile.impactSplashScale;
            evt.color = _PackedColorsRead[i];
            evt.pad0 = i;
            evt.pad1 = 0u;
            evt.pad2 = 0u;
            _SplatEvents[slot] = evt;
        }

        InterlockedAdd(_Counters[COUNTER_SETTLED_TOTAL], 1u);
        removed = true;
    }

    // Canvas plane acts as the world floor for surviving particles.
    if (!removed && pos.y - radius < _CanvasPlaneY)
    {
        pos.y = _CanvasPlaneY + radius;
        V4ReflectAgainstNormal(vel, float3(0, 1, 0), profile.surfaceRestitution, profile.surfaceFriction);
    }

    // Settle check (spec section 7): register only once velocity < epsilon, then
    // remove the particle from the live buffer entirely.
    bool nearPlane = (pos.y - radius) <= (_CanvasPlaneY + _SettleDistance);

    if (!removed && !V4IsInside(flags) && nearPlane && onCanvasRect && length(vel) < profile.settleEpsilon)
    {
        uint slot;
        InterlockedAdd(_Counters[COUNTER_SPLAT_EVENTS], 1u, slot);
        if (slot < _MaxSplatEvents)
        {
            V4SplatEvent evt;
            evt.uv = uv;
            evt.radius = radius;
            evt.contribution = 1.0;
            evt.color = _PackedColorsRead[i];
            // Stable sort key: InterlockedAdd slot order is scheduling-dependent, so
            // the splat kernel re-sorts events by source index for determinism.
            evt.pad0 = i;
            evt.pad1 = 0u;
            evt.pad2 = 0u;
            _SplatEvents[slot] = evt;
        }

        InterlockedAdd(_Counters[COUNTER_SETTLED_TOTAL], 1u);
        removed = true;
    }

    // Stage state + compaction pair. Sorting (removed = max key) preserves the
    // relative order of survivors, keeping compaction fully deterministic.
    _WriteBlock0[i] = float4(pos, radius);
    _WriteBlock1[i] = float4(vel, 0.0);
    _WritePackedColors[i] = _PackedColorsRead[i];
    _WriteFlags[i] = flags;
    _CompactionPairs[i] = uint2(removed ? 0xFFFFFFFFu : i, i);

    if (!removed)
    {
        InterlockedAdd(_Counters[COUNTER_WRITE_COUNT], 1u);
    }
}

// Test-only probe: mirrors FinalizeKernel XSPH/cohesion neighbor loop without mutating state.
// Writes 6 float4 rows per tracked slot:
//   0 meta(density, neighborCount, restDensity, C)
//   1 cohesionDelta
//   2 xsphDelta
//   3 y, r, lambda, deltaPreClamp
//   4 deltaPostClamp, clamped, inside, containInside
//   5 zone
[numthreads(64, 1, 1)]
void FinalizeTermsProbeKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount)
    {
        return;
    }

    int slot = -1;
    for (uint t = 0u; t < _DebugTrackCount; t++)
    {
        if (_DebugTrackIndices[t] == i)
        {
            slot = (int)t;
            break;
        }
    }

    if (slot < 0)
    {
        return;
    }

    uint flags = _Flags[i];
    V4GpuProfile profile = _Profiles[V4GetProfile(flags)];

    float4 oldP = _Block0[i];
    float3 predicted = _PredictedRead[i].xyz;
    float3 vel = _DeltaTime > 1e-6 ? (predicted - oldP.xyz) / _DeltaTime : float3(0, 0, 0);

    float h = _SmoothingRadius;
    float3 xsph = float3(0, 0, 0);
    float3 cohesion = float3(0, 0, 0);
    uint neighborCount = 0u;

    V4_FOREACH_NEIGHBOR_BEGIN(predicted, j)
        if (j == i || j >= _ActiveParticleCount)
        {
            continue;
        }

        float3 diff = predicted - _PredictedRead[j].xyz;
        float r = length(diff);
        if (r > h)
        {
            continue;
        }

        neighborCount++;
        float w = V4Poly6(r, h);
        float3 vj = _DeltaTime > 1e-6 ? (_PredictedRead[j].xyz - _Block0[j].xyz) / _DeltaTime : float3(0, 0, 0);
        xsph += (vj - vel) * w;
        if (r > 1e-6)
        {
            cohesion -= (diff / r) * w;
        }
    V4_FOREACH_NEIGHBOR_END

    float selfW = max(V4Poly6(0.0, h), 1e-6);
    float3 cohesionDelta = profile.cohesion * (cohesion / selfW) * _DeltaTime;
    float3 xsphDelta = profile.viscosity * (xsph / selfW);

    float3 localPos = V4ToLocal(predicted);
    float radial = length(float2(localPos.x, localPos.z));
    float restDensity = max(profile.restDensity, 1e-4);
    float density = _Densities[i];
    float constraint = density / restDensity - 1.0;
    float lambda = _Lambdas[i];

    float3 deltaPre = _Deltas[i].xyz;
    float maxCorrection = 0.2 * h;
    if (_DebugMaxCorrectionScale < 0.0)
    {
        maxCorrection = 1e10;
    }
    else if (_DebugMaxCorrectionScale > 0.0)
    {
        maxCorrection = _DebugMaxCorrectionScale * h;
    }

    float deltaPreLen = length(deltaPre);
    float3 deltaPost = deltaPre;
    bool clamped = false;
    if (deltaPreLen > maxCorrection)
    {
        clamped = true;
        deltaPost = deltaPre * (maxCorrection / deltaPreLen);
    }

    uint zone = V4GetZone(flags);
    bool inside = V4IsInside(flags);
    bool containInside = V4ComputeContainInside(flags, localPos, V4ToLocal(oldP.xyz));

    uint baseRow = (uint)slot * kV4DebugFinalizeProbeRowsPerSlot;
    _DebugFinalizeProbe[baseRow + 0u] = float4(density, (float)neighborCount, restDensity, constraint);
    _DebugFinalizeProbe[baseRow + 1u] = float4(cohesionDelta, 0.0);
    _DebugFinalizeProbe[baseRow + 2u] = float4(xsphDelta, 0.0);
    _DebugFinalizeProbe[baseRow + 3u] = float4(localPos.y, radial, lambda, deltaPreLen);
    _DebugFinalizeProbe[baseRow + 4u] = float4(length(deltaPost), clamped ? 1.0 : 0.0, inside ? 1.0 : 0.0, containInside ? 1.0 : 0.0);
    _DebugFinalizeProbe[baseRow + 5u] = float4((float)zone, 0.0, 0.0, 0.0);
}

// Diagnostic: per-particle neighbor count via the same 27-cell stencil as DensityKernel.
[numthreads(64, 1, 1)]
void BoundaryPressureNeighborKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount)
    {
        return;
    }

    float3 pi = _PredictedRead[i].xyz;
    float h = _SmoothingRadius;
    uint neighborCount = 0u;

    V4_FOREACH_NEIGHBOR_BEGIN(pi, j)
        if (j == i || j >= _ActiveParticleCount)
        {
            continue;
        }

        float3 diff = pi - _PredictedRead[j].xyz;
        if (length(diff) > h)
        {
            continue;
        }

        neighborCount++;
    V4_FOREACH_NEIGHBOR_END

    _DebugBoundaryPressureNeighbors[i] = neighborCount;
}

// After the external radix sort of _CompactionPairs, survivors occupy the prefix
// in their original order. Copy them from the write staging back into the
// canonical read set (bound here as the _Gather* targets).
[numthreads(64, 1, 1)]
void GatherKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount)
    {
        return;
    }

    uint2 pair = _SortedPairs[i];
    if (pair.x == 0xFFFFFFFFu)
    {
        return; // removed - slot i is beyond the new live count
    }

    uint src = pair.y;
    _GatherBlock0[i] = _StageBlock0[src];
    _GatherBlock1[i] = _StageBlock1[src];
    _GatherColors[i] = _StageColors[src];
    _GatherFlags[i] = _StageFlags[src];
}
