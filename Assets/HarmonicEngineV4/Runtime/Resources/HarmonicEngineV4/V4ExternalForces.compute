// External forces pass (spec sections 4-6.2, plan Phase 4):
// gravity + bucket moving-frame contribution (Inside) + priority zone force
// (single highest-priority zone, already resolved by classification) + top-band
// push-down. Consumes classification flags read-only; writes velocities in place.

#pragma kernel ExternalForcesKernel

#include "Include/V4Common.hlsl"
#include "Include/V4BucketZones.hlsl"
#include "Include/V4Profiles.hlsl"
#include "Include/V4BucketBindings.hlsl"

#define COUNTER_TOP_BAND 3

StructuredBuffer<float4> _Block0;          // position.xyz, radius
RWStructuredBuffer<float4> _Block1;        // velocity.xyz, unused
StructuredBuffer<uint> _Flags;
StructuredBuffer<V4Hole> _Holes;
StructuredBuffer<V4GpuProfile> _Profiles;
StructuredBuffer<uint> _Counters;

float _BucketInnerRadius;
float _BucketHeight;
float _BucketWallThickness;
float3 _Gravity;
float _DeltaTime;
float _CarryRate;              // relaxation rate toward the bucket frame velocity
float _TotalExpectedLoss;      // CPU-side EMA sum across holes (spec section 5)
float _DownwardScale;
float _ApplyNonInertialForces;
float _HoleExitSpeedOverride;
uint _LayerCount;
uint _ActiveParticleCount;

[numthreads(64, 1, 1)]
void ExternalForcesKernel(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ActiveParticleCount)
    {
        return;
    }

    uint flags = _Flags[i];
    V4GpuProfile profile = _Profiles[V4GetProfile(flags)];

    float3 pos = _Block0[i].xyz;
    float3 vel = _Block1[i].xyz;

    // Gravity applies to everyone, escaped included (they still fall to the canvas).
    vel += _Gravity * _DeltaTime;

    float4x4 worldToLocal;
    float4x4 localToWorld;
    float3 bucketLinearVelocity;
    float3 bucketAngularVelocity;
    float3 bucketAngularAcceleration;
    float3 bucketLinearAcceleration;
    float3 bucketWorldOrigin;
    V4LoadBucketKinematics(
        worldToLocal, localToWorld, bucketLinearVelocity, bucketAngularVelocity,
        bucketAngularAcceleration, bucketLinearAcceleration, bucketWorldOrigin);

    float3 localPos = mul(worldToLocal, float4(pos, 1.0)).xyz;
    if (V4BucketShouldContainInside(localPos, _BucketInnerRadius, _BucketHeight, _BucketWallThickness))
    {
        float3 frameVel = bucketLinearVelocity + cross(bucketAngularVelocity, pos - bucketWorldOrigin);
        float3 relVel = vel - frameVel;
        float blend = 1.0 - exp(-_CarryRate * _DeltaTime);
        vel += (frameVel - vel) * blend;

        if (_ApplyNonInertialForces > 0.5)
        {
            float3 rWorld = pos - bucketWorldOrigin;
            float3 centrifugal = -cross(bucketAngularVelocity, cross(bucketAngularVelocity, rWorld));
            float3 euler = -cross(bucketAngularAcceleration, rWorld);
            float3 coriolis = -2.0 * cross(bucketAngularVelocity, relVel);
            float3 translational = -bucketLinearAcceleration;
            vel += (centrifugal + euler + coriolis + translational) * _DeltaTime;
        }
    }

    uint zone = V4GetZone(flags);
    if (zone == V4_ZONE_HOLE0)
    {
        V4Hole hole = _Holes[V4GetHole(flags)];
        float3 dirLocal = hole.outwardNormal;
        float3 dirWorld = normalize(mul((float3x3)localToWorld, dirLocal));

        float targetExit = profile.zoneStrength0;
        if (_HoleExitSpeedOverride > targetExit)
        {
            targetExit = _HoleExitSpeedOverride;
        }

        float exitSpeed = dot(vel, dirWorld);
        if (exitSpeed < targetExit)
        {
            vel += dirWorld * (targetExit - exitSpeed);
        }
    }
    else if (zone == V4_ZONE_HEIGHT_LAYER)
    {
        uint layerIndex = V4GetHole(flags);
        if (_LayerCount > 0u && layerIndex == _LayerCount - 1u)
        {
            uint topCount = max(_Counters[COUNTER_TOP_BAND], 1u);
            float pushDown = _TotalExpectedLoss / (float)topCount * _DownwardScale * profile.topBandScale;
            float3 bucketDown = mul((float3x3)localToWorld, float3(0.0, -1.0, 0.0));
            vel += bucketDown * pushDown * _DeltaTime;
        }
    }

    _Block1[i] = float4(vel, 0.0);
}
